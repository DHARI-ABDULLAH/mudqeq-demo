# web_demo/.env.example — copy to .env and fill in locally.
# NEVER commit .env or put real secrets in this example file.
#
#   cp .env.example .env
#   # then edit .env and paste your OpenAI key on the OPENAI_API_KEY line.

# Required for المحادثة (chat). Search works without this.
OPENAI_API_KEY=

# Optional — default shown below if omitted.
OPENAI_MODEL=gpt-4o-mini

# Optional LLM tuning (defaults are safe for a low-cost public demo)
# OPENAI_MAX_OUTPUT_TOKENS=1024
# Leave OPENAI_TEMPERATURE empty to omit the parameter (reasoning models).
# OPENAI_TEMPERATURE=0.2
# OPENAI_TIMEOUT_SECONDS=60
# Retries apply to transient 5xx/network faults only — never to rate limits.
# OPENAI_MAX_RETRIES=1
# OPENAI_BASE_URL=

# Optional demo limits (defaults are safe for public demo)
# MAX_FILE_SIZE_MB=50
# MAX_PAGES=200
# MAX_QUESTIONS_PER_SESSION=20
# SESSION_TTL_MINUTES=30

# Optional URL-source bounds. Adding a link makes the SERVER fetch a page, so
# every one of these is a safety limit, not a preference. Only public http(s)
# addresses are ever fetched; loopback, private, and cloud-metadata addresses
# are rejected before the connection is opened and again on every redirect.
# MAX_URL_SOURCES_PER_SESSION=5      # concurrent links kept in a session
# MAX_URLS_PER_SESSION=15            # total fetches (adds + refreshes)
# MAX_URL_RESPONSE_BYTES=5000000     # hard cap on bytes read from a page
# MAX_URL_EXTRACTED_CHARS=400000     # cap on readable text kept after extraction
# MIN_URL_EXTRACTED_CHARS=200        # below this the page counts as unreadable
# URL_CONNECT_TIMEOUT=5
# URL_READ_TIMEOUT=15
# MAX_URL_REDIRECTS=3
# MAX_URL_CHUNKS=600

# Optional "تحليل حالة" (case analysis) bounds. Each successful analysis makes
# at most MAX_CASE_LLM_CALLS provider calls and is metered on its own quota.
# MAX_CASE_CHARS=6000
# MAX_CASE_RESEARCH_QUERIES=6
# MAX_RESULTS_PER_QUERY=5
# MAX_TOTAL_EVIDENCE_CHUNKS=18
# MAX_CASE_CONTEXT_CHARS=14000
# MAX_CASE_LLM_CALLS=4
# MAX_CASES_PER_SESSION=3
# MAX_CASE_FOLLOWUPS_PER_CASE=5
