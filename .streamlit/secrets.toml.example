# Streamlit Community Cloud Secrets (paste in dashboard — NEVER commit real values)
# App → Settings → Secrets
#
# IMPORTANT: keep these keys at the TOP LEVEL (no [section] header):
#
# OPENAI_API_KEY = "your-openai-key-here"
# OPENAI_MODEL = "gpt-4o-mini"
#
# Nested layouts such as [openai] api_key = "..." are also supported as a
# fallback, but the flat form above is recommended.
